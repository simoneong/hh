def count_coins(x):
    coin_counter = 0
    while x != 0:
        if x > 25 or x % 25 == 0:
            x = x - 25
            coin_counter += 1
        elif x > 10 or x % 10 == 0:
            x = x - 10
            coin_counter += 1
        elif x > 5 or x % 5 == 0:
            x = x - 5
            coin_counter += 1
        else:
            coin_counter = coin_counter + x
            x = x - x
    return("coins = " + str(coin_counter))

y = [100,99,74]
for z in y:
    print(count_coins(z))
